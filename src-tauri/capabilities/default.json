{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "updater:default",
    "process:allow-restart",
    "allow-load-config",
    "allow-take-config-recovery-notice",
    "allow-get-config-file-path",
    "allow-open-config-folder",
    "allow-save-config",
    "allow-validate-manual-browser",
    "allow-validate-regex-patterns",
    "allow-refresh-browsers",
    "allow-list-running-browser-ids",
    "allow-list-missing-browser-ids",
    "allow-preview-route-with-config",
    "allow-route-and-open-with-config",
    "allow-show-picker-for-url",
    "allow-show-settings-window-command",
    "allow-open-windows-default-apps",
    "allow-get-browser-registration-status",
    "allow-register-hops-as-browser",
    "allow-unregister-hops-as-browser",
    "allow-reset-config"
  ]
}
